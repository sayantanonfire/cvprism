{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cvprism.dev/schemas/role.v1.json",
  "title": "cvprism role profile v1",
  "type": "object",
  "required": [
    "v",
    "id",
    "title",
    "sections"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "description": "headline under the name"
    },
    "extends": {
      "type": "string",
      "description": "id of a base role"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "summary",
          "experience",
          "projects",
          "skills",
          "publications",
          "education",
          "certifications",
          "awards",
          "talks",
          "fieldwork",
          "teaching",
          "languages"
        ]
      }
    },
    "include": {
      "type": "object",
      "properties": {
        "dom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills_any": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 2
        },
        "since": {
          "type": "string",
          "description": "YYYY or YYYY-MM"
        }
      }
    },
    "exclude": {
      "type": "object",
      "properties": {
        "dom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ctx": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "weights": {
      "type": "object",
      "description": "relative 0-1 weights for scoring",
      "properties": {
        "publications": {
          "type": "number"
        },
        "delivery": {
          "type": "number"
        },
        "research": {
          "type": "number"
        },
        "results": {
          "type": "number"
        },
        "recency": {
          "type": "number"
        },
        "depth": {
          "type": "number"
        }
      }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "market phrases to prefer when true; never used to add claims"
    },
    "limits": {
      "type": "object",
      "properties": {
        "pages": {
          "type": "number",
          "minimum": 1
        },
        "bullets_per_position": {
          "type": "integer",
          "default": 5
        },
        "skills_max": {
          "type": "integer",
          "default": 24
        },
        "cards_to_llm": {
          "type": "integer",
          "default": 60
        }
      }
    },
    "template": {
      "type": "string",
      "description": "RenderCV theme or templates/<name>"
    },
    "outputs": {
      "type": "array",
      "items": {
        "enum": [
          "pdf",
          "docx",
          "md",
          "tex"
        ]
      }
    },
    "tone": {
      "type": "string",
      "description": "short style hint, e.g. 'impact-first, past tense'"
    }
  }
}
