{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cvprism.dev/schemas/card.v1.json",
  "title": "cvprism evidence card v1",
  "type": "object",
  "required": [
    "v",
    "id",
    "k",
    "s",
    "d",
    "r",
    "ctx",
    "txt",
    "t",
    "dev",
    "src"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^c_[0-9a-f]{16}$"
    },
    "k": {
      "enum": [
        "skill",
        "result",
        "work"
      ]
    },
    "why": {
      "enum": [
        "new_skill",
        "depth_up",
        "new_result",
        "work",
        "manual"
      ]
    },
    "s": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "d": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "r": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/result"
        }
      ]
    },
    "ctx": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/slug"
        }
      ]
    },
    "txt": {
      "type": "string",
      "minLength": 8,
      "maxLength": 220
    },
    "meth": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "tl": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "dom": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "t": {
      "type": "string",
      "format": "date-time"
    },
    "dev": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-[0-9a-f]{4}$"
    },
    "src": {
      "enum": [
        "claude_session",
        "git_commit",
        "watcher",
        "manual",
        "import"
      ]
    },
    "ref": {
      "type": "string",
      "maxLength": 120
    },
    "conf": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "needs_metric",
          "needs_review",
          "low_confidence",
          "manual_raw"
        ]
      }
    },
    "sup": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^c_[0-9a-f]{16}$"
      }
    },
    "lang": {
      "type": "string",
      "default": "en"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "k": {
            "const": "result"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "r": {
                "$ref": "#/$defs/result"
              }
            }
          },
          {
            "properties": {
              "flags": {
                "contains": {
                  "const": "needs_metric"
                }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "result": {
      "type": "object",
      "required": [
        "m",
        "val",
        "unit",
        "dir"
      ],
      "properties": {
        "m": {
          "type": "string",
          "maxLength": 60,
          "description": "metric name, e.g. 'inference latency'"
        },
        "val": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "maxLength": 20,
          "description": "'%', 'ms', 'x', 'km2', 'users', ..."
        },
        "base": {
          "type": [
            "number",
            "null"
          ],
          "description": "baseline value if stated"
        },
        "dir": {
          "enum": [
            "up",
            "down",
            "abs"
          ],
          "description": "improvement direction or absolute figure"
        }
      }
    }
  }
}
